FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=80 HOME=/tmp
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates fontconfig fonts-liberation \
        fonts-crosextra-caladea fonts-crosextra-carlito fonts-noto-core \
        libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY . /app
EXPOSE 80
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-80} --workers 1 --threads 4 --timeout 105 --access-logfile - --error-logfile - app:app"]
